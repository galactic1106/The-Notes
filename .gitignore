# Obsidian Workspace & Cache (Recommended)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian Trash
.trash/

# Optional: Plugins, Themes & Settings (Uncomment to ignore)
.obsidian/themes/
# .obsidian/snippets/
.obsidian/appearance.json
# .obsidian/hotkeys.json

# Optional: Frequent Plugin Caches
.obsidian/plugins/obsidian-git/data.json
.obsidian/plugins/recent-files-obsidian/data.json

# Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
/architettura reti ed internet/Excalidraw/*.svg

# Ignore all plugin files by default
.obsidian/plugins/*

# Keep the list of installed/enabled plugins (optional, helpful for syncing)
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json

# Re-include each plugin's directory so Git can traverse into it
!.obsidian/plugins/*/

# Ignore everything inside each plugin folder...
.obsidian/plugins/*/*

# ...except the plugin's settings file
!.obsidian/plugins/*/data.json
